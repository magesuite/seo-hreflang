<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MageSuite\SeoHreflang\Model\EntityPool">
        <arguments>
            <argument name="entities" xsi:type="array">
                <item name="category" xsi:type="object">MageSuite\SeoHreflang\Model\Entity\Category</item>
                <item name="product" xsi:type="object">MageSuite\SeoHreflang\Model\Entity\Product</item>
                <item name="cms_page" xsi:type="object">MageSuite\SeoHreflang\Model\Entity\CmsPage</item>
                <item name="brand" xsi:type="object">MageSuite\SeoHreflang\Model\Entity\Brand</item>
            </argument>
        </arguments>
    </type>

    <type name="MageSuite\SeoHreflang\Model\Entity\Product">
        <arguments>
            <argument name="urlFinder" xsi:type="object">MageSuite\SeoHreflang\Model\ResourceModel\MultiStoreUrlRewriteLoader</argument>
        </arguments>
    </type>

    <type name="MageSuite\SeoHreflang\Model\Entity\Category">
        <arguments>
            <argument name="urlFinder" xsi:type="object">MageSuite\SeoHreflang\Model\ResourceModel\MultiStoreUrlRewriteLoader</argument>
        </arguments>
    </type>

    <type name="MageSuite\SeoHreflang\ViewModel\Hreflang">
        <arguments>
            <argument name="allowedQueryParameters" xsi:type="array">
                <item name="p" xsi:type="string">p</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Store\Model\Store">
        <plugin name="get_current_url_fix" type="MageSuite\SeoHreflang\Plugin\Model\Store" sortOrder="10"/>
    </type>
</config>
